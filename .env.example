# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (extracció d'albarans externs)
ANTHROPIC_API_KEY=

# Login simple
# IMPORTANT: el hash conté "$" i Next.js interpola "$VAR" als fitxers .env
# (encara que vagi entre cometes) — escapa cada "$" com a "\$".
# Exemple: APP_LOGIN_PASSWORD_HASH="\$2b\$10\$AbCdEf..."
APP_LOGIN_USER=
APP_LOGIN_PASSWORD_HASH=

# Sessió
SESSION_SECRET=
